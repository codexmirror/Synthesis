{
  "name": "synthesis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:online": "npm run server:build && (node --experimental-specifier-resolution=node server/index.mjs & vite --mode online)",
    "server:build": "tsc -p tsconfig.server.json && node scripts/fix-server-imports.mjs",
    "server": "npm run server:build && node --experimental-specifier-resolution=node server/index.mjs",
    "build": "tsc -b && vite build",
    "build:online": "tsc -b && npm run server:build && vite build --mode online",
    "start:online": "SYNTHESIS_ONLINE_ENV=production node --experimental-specifier-resolution=node server/index.mjs",
    "test": "node scripts/run-tests.mjs focused",
    "test:ci": "node scripts/run-tests.mjs ci",
    "docs:check": "node scripts/docs-check.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
